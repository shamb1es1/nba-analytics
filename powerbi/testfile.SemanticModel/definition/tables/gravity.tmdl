	column 'AVGGRAVITYSCORE (bins)' =
			IF(
				ISBLANK('gravity'[AVGGRAVITYSCORE]),
				BLANK(),
				IF(
					'gravity'[AVGGRAVITYSCORE] >= 0,
					ROUNDDOWN('gravity'[AVGGRAVITYSCORE], 0),
					ROUNDUP('gravity'[AVGGRAVITYSCORE], 0)
				)
			)
		lineageTag: 672ec4ed-1b9a-44df-b44b-6b531bd1ec93
