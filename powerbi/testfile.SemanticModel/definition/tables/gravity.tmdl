table gravity
	lineageTag: c2eb73b4-19de-482a-a4dc-5a4427c535c9

	measure 'Standard Deviation' =
			
			STDEVX.P(
			    ALLSELECTED('gravity'[AVGGRAVITYSCORE]),
			    'gravity'[AVGGRAVITYSCORE]
			)
		lineageTag: 1d6f9b8e-b91f-43b3-a19c-d957cf35d08e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'minus 1 std' =
			
